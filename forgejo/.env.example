# Forgejo Practice Environment
# Copy this file to .env and adjust values as needed.
# WARNING: Change the default password before use.

FORGEJO_DB_PASSWORD=changeme
FORGEJO_DB_HOST=host.docker.internal
FORGEJO_DB_NAME=forgejo
FORGEJO_DB_USER=forgejo

# Data directory on the host (default: local ./data directory)
# FORGEJO_DATA_DIR=/mnt/backups/forgejo
