# Postgres connection string used by the API and Alembic.
# Required. The container does NOT start a database.
DATABASE_URL=postgresql://postgres:password@host.docker.internal:5432/postgres

# Optional. Uvicorn listen port inside the container (default 8000).
# PORT is read from the process environment by the entrypoint.
# Pass it with `docker run -e PORT=...` or `--env-file`; a file mounted at
# `/app/.env` is used for DATABASE_URL by Settings, but does NOT change PORT.
PORT=8000

# --- Connecting to Postgres on the Docker host ---
#
# `localhost` / `127.0.0.1` inside the container is the container itself,
# not the machine running Docker. Do not use localhost in DATABASE_URL
# unless Postgres is in the same container (it is not).
#
# host.docker.internal / published host ports only work if Postgres is
# listening on 0.0.0.0 (or the docker0/bridge IP), NOT solely on 127.0.0.1.
# A publish of `127.0.0.1:5432:5432` is unreachable via host-gateway.
# Bare-metal Postgres also needs listen_addresses and pg_hba.conf to allow
# the Docker bridge subnet.
#
# Options (preferred first):
# 1. Attach to the existing Docker network and use the Postgres container
#    hostname (recommended for this home lab: postgres-practice on
#    postgres_default):
#      docker run --network postgres_default ...
#    DATABASE_URL=postgresql://user:pass@postgres-practice:5432/dbname
#
# 2. host.docker.internal (Docker Desktop; Linux needs extra flag):
#      docker run --add-host=host.docker.internal:host-gateway ...
#    DATABASE_URL=postgresql://user:pass@host.docker.internal:5432/dbname
#    Requires Postgres published on 0.0.0.0 (or reachable from the bridge).
#
# 3. Host LAN IP if Postgres is bound there, e.g. 192.168.1.10:5432
#
# Build and run (standalone image, no compose):
#   docker build -t pomodoro-api .
#   docker run --rm -p 8000:8000 \
#     --network postgres_default \
#     -e DATABASE_URL=postgresql://postgres:password@postgres-practice:5432/postgres \
#     pomodoro-api
#
# Startup: alembic upgrade head, then uvicorn on 0.0.0.0:$PORT.
# A failed migration exits the container; the API does not start.
