# LPIC-1 Practice Environment Configuration
# Copy this file to .env and adjust as needed:
#   cp .env.example .env

# User inside the container
USERNAME=student
USER_UID=1000
USER_GID=1000
# Note: Ubuntu uses UID/GID 1001 because 1000 is taken by the 'ubuntu' user in the base image

# Dotfiles repository (cloned during image build)
DOTFILES_REPO=https://github.com/lpoblet/dotfiles

# Path to your scripts repo (mounted read-only at /home/student/scripts)
# Default (../) assumes compose.yaml is in scripts/docker/
SCRIPTS_PATH=../

# SSH port mappings (host:container) — one per distro
SSH_PORT_DEBIAN=2222
SSH_PORT_UBUNTU=2223
SSH_PORT_FEDORA=2224
SSH_PORT_ALMALINUX=2225
SSH_PORT_OPENSUSE=2226
SSH_PORT_ALPINE=2227
